{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curo.local/schemas/execution-replay-manifest.schema.json",
  "title": "Curo Execution Replay Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "artifact_id", "version", "executable", "args", "cwd", "timeout_seconds", "inputs", "expected_outputs", "expected_checks", "provenance"],
  "properties": {
    "manifest_type": {"const": "execution_replay_manifest"},
    "artifact_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "number"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}},
    "expected_outputs": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}},
    "expected_checks": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "provenance-record.schema.json"}
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "status": {"enum": ["VERIFIED", "UNKNOWN"]}
      }
    }
  }
}
