{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curo.local/schemas/hitl-packet.schema.json",
  "title": "Curo HITL Packet",
  "type": "object",
  "required": ["artifact_type", "packet_version", "packet_id", "project_id", "review_id", "status", "decisions"],
  "properties": {
    "artifact_type": {"const": "curo_hitl_packet"},
    "packet_version": {"type": "string"},
    "packet_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "status": {"const": "HITL_REQUIRED"},
    "summary": {"type": "object"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "blocking_findings": {"type": "array"},
    "authorized_transition": {"type": "string"}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["id", "question", "why_human_input_is_required", "impact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "why_human_input_is_required": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "options": {"type": "array"},
        "recommended_option": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
