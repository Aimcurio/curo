{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curo.local/schemas/scoped-registry.schema.json",
  "title": "Curo Scoped Registry Shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "registry_id", "scope", "owner", "updated_at", "status", "module", "artifacts", "invariants"],
  "properties": {
    "registry_version": {"type": "integer", "minimum": 1},
    "registry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "scope": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date"},
    "status": {"enum": ["active", "archived"]},
    "module": {"$ref": "#/$defs/entry"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "type", "version", "owner", "status", "authoritative"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "authoritative": {"type": "boolean"}
      }
    }
  }
}
