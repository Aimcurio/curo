{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curo.local/schemas/artifact-verification-manifest.schema.json",
  "title": "Curo Artifact Verification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "artifact_id", "version", "artifacts", "expected_checks", "provenance"],
  "properties": {
    "manifest_type": {"const": "artifact_verification_manifest"},
    "artifact_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 1},
          "schema": {"type": ["string", "null"]}
        }
      }
    },
    "expected_checks": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "provenance-record.schema.json"}
  }
}
