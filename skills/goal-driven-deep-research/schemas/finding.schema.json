{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curo://goal-driven-deep-research/finding.schema.json",
  "title": "Goal-Driven Deep Research Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "investigation_id", "statement", "classification", "status", "confidence", "evidence_ids", "contradiction_ids", "remaining_unknowns"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "investigation_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "classification": {"enum": ["EVIDENCE", "INFERENCE", "RECOMMENDATION", "UNKNOWN"]},
    "status": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "CHALLENGED", "CONTRADICTED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "contradiction_ids": {"type": "array", "items": {"type": "string"}},
    "remaining_unknowns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUPPORTED"}}, "required": ["status"]},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}}
    }
  ]
}
